# YUZUKI AI — Environment Configuration
# Copy to .env — Never commit .env to Git!

# ── Bot identity ────────────────────────────────────────────────────────────
OWNER_NUMBER=
BOT_NAME=Yuzuki AI
PREFIX=.
VERSION=2.0.0

# ── Behaviour ────────────────────────────────────────────────────────────────
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
PUBLIC_MODE=true

# ── AI Provider (Phase 6) ────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: auto | groq | gemini | openrouter | pollinations
# "auto" selects the first available provider based on which keys are set.
AI_PROVIDER=auto
# Optional: override fallback order (comma-separated)
AI_FALLBACK_CHAIN=

# ── Groq (FREE tier) ─────────────────────────────────────────────────────────
# Free API key: https://console.groq.com
# Free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (FREE tier) ────────────────────────────────────────────────
# Free API key: https://aistudio.google.com (no credit card)
# Free models: gemini-2.0-flash-lite, gemini-1.5-flash, gemini-1.5-flash-8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ── OpenRouter (FREE models available) ───────────────────────────────────────
# Free API key: https://openrouter.ai (free models marked with :free suffix)
# Free models: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── Pollinations.ai (NO KEY REQUIRED — always free) ──────────────────────────
# Zero cost, zero registration. Used as last-resort fallback automatically.
# Models: openai-large, openai, mistral, mistral-large, deepseek
POLLINATIONS_MODEL=openai-large

# ── Paths ────────────────────────────────────────────────────────────────────
SESSION_DIR=./session
DB_PATH=./database.sqlite
TEMP_DIR=./temp
LOGS_DIR=./logs

# ── Network ──────────────────────────────────────────────────────────────────
PORT=3000
MAX_RECONNECT=10
RECONNECT_DELAY=5000
DEBUG=false
