# YUZUKI AI — Environment Configuration
# Copy to .env — Never commit .env to Git!

OWNER_NUMBER=
BOT_NAME=Yuzuki AI
PREFIX=.
VERSION=2.0.0
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
PUBLIC_MODE=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SESSION_DIR=./session
DB_PATH=./database.sqlite
TEMP_DIR=./temp
LOGS_DIR=./logs
PORT=3000
MAX_RECONNECT=10
RECONNECT_DELAY=5000
DEBUG=false
